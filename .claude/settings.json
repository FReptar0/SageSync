{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npm install)",
      "Bash(npm install:*)",
      "Bash(npm ci)",
      "Bash(npm start)",
      "Bash(npm run sync:*)",
      "Bash(npm run dev)",
      "Bash(npm run maintenance:*)",
      "Bash(npm run obfuscate:*)",
      "Bash(npx jest:*)",
      "Bash(node --version)",
      "Bash(node -c:*)",
      "Bash(node -e:*)",
      "Bash(node src/maintenance.js)",
      "Bash(node src/maintenance.js:*)",
      "Bash(node scripts/setup-automap.js --dry-run)",
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff)",
      "Bash(git diff:*)",
      "Bash(git log)",
      "Bash(git log:*)",
      "Bash(git branch)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push)",
      "Bash(git push:*)",
      "Bash(git fetch)",
      "Bash(git fetch:*)",
      "Bash(git ls-files:*)",
      "Bash(git rev-parse:*)",
      "Bash(git show:*)",
      "Bash(git worktree:*)",
      "Bash(gh pr:*)",
      "Bash(gh issue:*)",
      "Bash(gh repo:*)",
      "Bash(gh api:*)",
      "Bash(gh run:*)",
      "Bash(curl http://localhost:*)",
      "Bash(curl https://app.fracttal.com/*)",
      "Bash(curl https://sageconnect-license.vercel.app/*)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:nodejs.org)",
      "WebFetch(domain:expressjs.com)",
      "WebFetch(domain:api.fracttal.com)",
      "WebFetch(domain:help.fracttal.com)",
      "WebFetch(domain:github.com)"
    ],
    "ask": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)",
      "Bash(npm run obfuscate:push)",
      "Bash(node scripts/obfuscate.js --push)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.fracttal-token)",
      "Read(./.sage-credentials)",
      "Read(./private_key*)",
      "Read(**/*.pem)",
      "Read(./postman/Fracttal_Environment.json)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./.fracttal-token)",
      "Edit(./.sage-credentials)",
      "Edit(**/*.pem)",
      "Edit(./private_key*)",
      "Write(./.env)",
      "Write(./.fracttal-token)",
      "Bash(cat .env)",
      "Bash(cat .env:*)",
      "Bash(cat .fracttal-token)",
      "Bash(cat .fracttal-token:*)"
    ]
  },
  "autoMemoryEnabled": true
}
